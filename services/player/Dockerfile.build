FROM rust:1.89-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev ca-certificates && rm -rf /var/lib/apt/lists/*
# The player binary links only to the libraries above. These additional runtime
# plugins are only for the CPU fakesink integration tests.
RUN apt-get update && apt-get install -y --no-install-recommends gstreamer1.0-plugins-good gstreamer1.0-libav && rm -rf /var/lib/apt/lists/*
WORKDIR /work
ENV CARGO_TARGET_DIR=/work/target/linux-native
